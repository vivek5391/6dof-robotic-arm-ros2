    <collision>
      <origin xyz="0 0.015 -0.0125" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Wrist_.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_5" type="revolute">
