    <child link="gripper_left_inner_link"/>
    <origin xyz="-0.019815 0.078 0.015" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0"/>
    <mimic joint="gripper_joint" multiplier="1.0" offset="0.0"/>
