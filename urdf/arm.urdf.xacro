    <child link="gripper_link"/>
    <origin xyz="0.021 0 -0.0165" rpy="3.14159 -1.5708 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.05" upper="1.05" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="gripper_link">
    <inertial>
      <origin xyz="-0.00992 0.03289 0.00851" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.000005" ixy="0.0" ixz="0.0" iyy="0.000002" iyz="0.0" izz="0.000005"/>
