<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_dof_arm">

  <material name="dark_gray">
    <color rgba="0.22 0.22 0.22 1.0"/>
  </material>

  <material name="orange">
    <color rgba="1.0 0.45 0.0 1.0"/>
  </material>

  <material name="white">
    <color rgba="0.92 0.92 0.92 1.0"/>
  </material>

  <link name="world"/>

  <joint name="world_to_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="-0.01843 0.0 0.01548" rpy="0 0 0"/>
      <mass value="0.1938"/>
      <inertia ixx="0.000312" ixy="0.0" ixz="0.0" iyy="0.001171" iyz="0.0" izz="0.001324"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="shoulder_link"/>
    <origin xyz="-0.10 0 0.07" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="shoulder_link">
    <inertial>
      <origin xyz="0.005 -0.00254 0.01039" rpy="0 0 0"/>
      <mass value="0.0207"/>
      <inertia ixx="0.000022" ixy="0.0" ixz="0.0" iyy="0.000022" iyz="0.0" izz="0.000034"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Shoulder.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Shoulder.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link"/>
    <child link="elbow_link"/>
    <origin xyz="0.00906 -0.01413 0.03490" rpy="1.5708 0 -1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.52" upper="1.31" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="elbow_link">
    <inertial>
      <origin xyz="0.05573 0.0 0.00793" rpy="0 0 0"/>
      <mass value="0.0196"/>
      <inertia ixx="0.000003" ixy="0.0" ixz="0.0" iyy="0.000038" iyz="0.0" izz="0.000040"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Elbow.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Elbow.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_3" type="revolute">
    <parent link="elbow_link"/>
    <child link="arm_link"/>
    <origin xyz="0.1115 0 0" rpy="3.1416 0 1.5708"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.13" upper="1.22" effort="20.0" velocity="2.0"/>
  </joint>

  <link name="arm_link">
    <inertial>
      <origin xyz="0.04629 0.00007 0.01412" rpy="0 0 0"/>
      <mass value="0.0216"/>
      <inertia ixx="0.000005" ixy="0.0" ixz="0.0" iyy="0.000028" iyz="0.0" izz="0.000029"/>
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/arm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="joint_4" type="revolute">
    <parent link="arm_link"/>
    <child link="wrist_link"/>
    <origin xyz="0.1035 -0.008 0.01825" rpy="3.14159 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="wrist_link">
    <inertial>
      <origin xyz="0.01905 0.0 -0.00546" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000001"/>
    </inertial>
    <visual>
      <origin xyz="0 0.015 -0.0125" rpy="0 0 0"/>
      <geometry>
        <mesh filename="package://arm_description/meshes/Wrist_.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="dark_gray"/>
