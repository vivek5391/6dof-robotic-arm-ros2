      <geometry>
        <mesh filename="package://arm_description/meshes/gripper_base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>

  <joint name="tcp_joint" type="fixed">
    <parent link="gripper_link"/>
    <child link="tcp_link"/>
    <origin xyz="-0.013936 0.120 0.0165" rpy="0 0 0"/>
  </joint>

  <link name="tcp_link"/>

  <joint name="gripper_joint" type="revolute">
    <parent link="gripper_link"/>
    <child link="gripper_left_gear_link"/>
    <origin xyz="-0.0275 0.057565 0.015" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-0.50" upper="0.65" effort="10.0" velocity="2.0"/>
    <limit lower="0.00" upper="0.65" effort="10.0" velocity="2.0"/>
  </joint>

  <link name="gripper_left_gear_link">
