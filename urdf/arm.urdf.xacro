    <child link="gripper_left_finger_link"/>
    <origin xyz="-0.000004 0.031 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10.0" velocity="2.0"/>
    <mimic joint="gripper_joint" multiplier="-1.0" offset="0.0"/>
  </joint>

  <link name="gripper_left_finger_link">
    <inertial>
      <origin xyz="0.00538 0.02295 0.0015" rpy="0 0 0"/>
      <mass value="0.005"/>
      <inertia ixx="0.000001" ixy="0.0" ixz="0.0" iyy="0.000001" iyz="0.0" izz="0.000002"/>
